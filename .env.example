PORT=3102
NODE_ENV=development
HOST_PORT=3102

# Activer le profil tls sur le VPS : COMPOSE_PROFILES=tls.
COMPOSE_PROFILES=
TLS_PORT=8446
TLS_CERT_ROOT=./deploy/certs

# SMTP : 465 utilise généralement SMTP_SECURE=true ; 587 utilise false + STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_POOL_CONNECTIONS=10
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=
SMTP_PASS=

MAIL_FROM=no-reply@example.local
MAIL_FROM_NAME=Exhibition Hub

# Facultatif en développement. Obligatoire sur un service exposé publiquement.
MAIL_API_KEY=
# Plusieurs clés peuvent être séparées par des virgules pour isoler/faire tourner les sites.
MAIL_API_KEYS=
CORS_ORIGINS=*
MAX_ATTACHMENT_BYTES=10485760
MAX_RECIPIENTS=10

# Protection contre la surcharge, par instance.
RATE_LIMIT_WINDOW_MS=60000
MAIL_RATE_LIMIT=120
MAX_CONCURRENT_SENDS=10
MAX_QUEUED_SENDS=200
SEND_QUEUE_TIMEOUT_MS=5000
TRUST_PROXY_HOPS=1
REQUEST_TIMEOUT_MS=30000
