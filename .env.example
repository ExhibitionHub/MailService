PORT=3102

# SMTP : 465 utilise généralement SMTP_SECURE=true ; 587 utilise false + STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=

MAIL_FROM=no-reply@example.local
MAIL_FROM_NAME=Exhibition Hub

# Facultatif en développement. Obligatoire sur un service exposé publiquement.
MAIL_API_KEY=
CORS_ORIGINS=*
MAX_ATTACHMENT_BYTES=10485760
MAX_RECIPIENTS=10
TRUST_PROXY=true
